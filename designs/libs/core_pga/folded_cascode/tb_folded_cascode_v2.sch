C {devices/code_shown.sym} 2630 -630 0 0 {name=NGSPICE_ac only_toplevel=true
value="
.control
  * 1. Corremos la simulación AC hasta 10 GHz
  ac dec 20 1 10g
  
  * 2. Definición de la salida diferencial y creación del vector en dB
  let vout = v(voutp) - v(voutn)
  let vout_db = db(vout)

  * 3. Cálculo de la ganancia DC y el objetivo de -3 dB
  let dc_gain_db = vout_db[0]
  let target_3db = dc_gain_db - 3.0
  
  echo "=================================================="
  print dc_gain_db
  print target_3db
  echo "=================================================="

  * ==================================================
  * EL TRUCO MAESTRO:
  * Convertimos el número a una variable de entorno de texto (string)
  * ==================================================
  set val_3db = $&target_3db

  * 4. Comandos de medición usando la variable de texto y fall=1
  meas ac f_3db when vout_db=$val_3db fall=1
  meas ac gbw_0db when vout_db=0 fall=1
  
  * ==================================================

  * 5. Graficar la Magnitud en dB
  plot vout_db
.endc
"}
