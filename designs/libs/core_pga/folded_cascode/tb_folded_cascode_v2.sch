C {vsource.sym} 40 -430 0 0 {name=V3 value=2.8 savecurrent=false}
C {gnd.sym} 40 -360 0 0 {name=l4 lab=0}
C {lab_pin.sym} 40 -520 0 0 {name=p9 sig_type=std_logic lab=VDD2V2}
C {vsource.sym} -100 -430 0 0 {name=V4 value=0.8 savecurrent=false}
