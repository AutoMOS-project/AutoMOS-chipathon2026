C {vsource.sym} 1670 -990 0 0 {name=V3 value=2.8 savecurrent=false}
C {gnd.sym} 1670 -920 0 0 {name=l4 lab=0}
C {lab_pin.sym} 1670 -1080 0 0 {name=p9 sig_type=std_logic lab=VDD2V2}
